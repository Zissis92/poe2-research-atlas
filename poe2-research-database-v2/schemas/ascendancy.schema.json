{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ascendancy",
  "type": "object",
  "required": [
    "id",
    "name",
    "class",
    "nodes",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "class": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "modifier_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mechanic_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": [
        "confidence",
        "sources"
      ],
      "properties": {
        "confidence": {
          "enum": [
            "official",
            "extracted",
            "verified_manual",
            "community",
            "hypothesis"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "verified_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "game_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
