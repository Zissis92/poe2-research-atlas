{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Passive tree node",
  "type": "object",
  "required": [
    "id",
    "name",
    "node_type",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "node_type": {
      "enum": [
        "small",
        "notable",
        "keystone",
        "jewel_socket",
        "ascendancy",
        "other"
      ]
    },
    "stats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "modifier_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "class_start": {
      "type": [
        "string",
        "null"
      ]
    },
    "coordinates": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": [
        "confidence",
        "sources"
      ],
      "properties": {
        "confidence": {
          "enum": [
            "official",
            "extracted",
            "verified_manual",
            "community",
            "hypothesis"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "verified_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "game_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
