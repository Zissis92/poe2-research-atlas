{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Patch record",
  "type": "object",
  "required": [
    "id",
    "name",
    "released_at",
    "changes",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "released_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entity_id",
          "change_type"
        ],
        "properties": {
          "entity_id": {
            "type": "string"
          },
          "change_type": {
            "enum": [
              "added",
              "removed",
              "modified",
              "renamed",
              "fixed",
              "unknown"
            ]
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": [
        "confidence",
        "sources"
      ],
      "properties": {
        "confidence": {
          "enum": [
            "official",
            "extracted",
            "verified_manual",
            "community",
            "hypothesis"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "verified_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "game_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
