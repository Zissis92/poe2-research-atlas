{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized modifier",
  "type": "object",
  "required": [
    "id",
    "name",
    "target",
    "operation",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "target": {
      "type": "string"
    },
    "operation": {
      "enum": [
        "add",
        "increase",
        "more",
        "override",
        "convert",
        "gain_as_extra",
        "set",
        "multiply",
        "conditional",
        "trigger"
      ]
    },
    "value": {
      "type": [
        "number",
        "string",
        "null"
      ]
    },
    "unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "scope": {
      "enum": [
        "local",
        "global",
        "skill",
        "support",
        "entity",
        "enemy",
        "area",
        "unknown"
      ]
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stacking_group": {
      "type": [
        "string",
        "null"
      ]
    },
    "calculation_stage": {
      "enum": [
        "base",
        "conversion",
        "added",
        "increased",
        "more",
        "critical",
        "mitigation",
        "final",
        "unknown"
      ]
    },
    "source_entity_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": [
        "confidence",
        "sources"
      ],
      "properties": {
        "confidence": {
          "enum": [
            "official",
            "extracted",
            "verified_manual",
            "community",
            "hypothesis"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "verified_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "game_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
