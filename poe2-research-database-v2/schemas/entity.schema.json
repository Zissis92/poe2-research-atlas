{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generic PoE2 entity",
  "type": "object",
  "required": [
    "id",
    "name",
    "entity_type",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "entity_type": {
      "enum": [
        "skill",
        "support",
        "spirit_gem",
        "passive",
        "keystone",
        "ascendancy",
        "unique",
        "item_base",
        "modifier",
        "mechanic",
        "tag",
        "monster",
        "boss",
        "experiment"
      ]
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "introduced_in": {
      "type": [
        "string",
        "null"
      ]
    },
    "removed_in": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": [
        "confidence",
        "sources"
      ],
      "properties": {
        "confidence": {
          "enum": [
            "official",
            "extracted",
            "verified_manual",
            "community",
            "hypothesis"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "verified_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "game_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
