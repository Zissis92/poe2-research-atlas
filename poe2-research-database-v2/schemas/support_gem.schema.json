{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized support gem",
  "type": "object",
  "required": [
    "id",
    "name",
    "tags",
    "compatibility",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "compatibility": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "tag_rules",
            "explicit",
            "hybrid",
            "unknown"
          ]
        },
        "required_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "any_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "explicit_skill_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded_skill_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "modifier_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mechanic_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": [
        "confidence",
        "sources"
      ],
      "properties": {
        "confidence": {
          "enum": [
            "official",
            "extracted",
            "verified_manual",
            "community",
            "hypothesis"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "verified_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "game_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
